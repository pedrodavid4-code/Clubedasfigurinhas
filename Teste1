let currentYear='2014', currentGroup='', currentTeam='Brasil', stickerQuery='', cart=[];
try{cart=JSON.parse(localStorage.getItem('cf_cart')||'[]');if(!Array.isArray(cart))cart=[]}catch(e){cart=[]}
function money(v){return v.toLocaleString('pt-BR',{style:'currency',currency:'BRL'})}
function esc(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function go(id){
  const el=document.getElementById(id);
  if(!el) return;
  document.querySelectorAll('.screen').forEach(x=>x.classList.remove('active'));
  el.classList.add('active');
  window.scrollTo({top:0,behavior:'instant'});
  if(id==='cart') renderCart();
}
function historyBack(){go('home')}
function openCup(year){
  currentYear=year;
  const defTeam={2014:'Brasil',2018:'Brasil',2022:'Brasil',2026:'Brasil'}[year]||'Brasil';
  const defGroup=((GROUPS[year]||[]).find(g=>g.slice(1).includes(defTeam))||['A'])[0];
  currentTeam=defTeam; currentGroup=defGroup;
  document.getElementById('cupTitle').textContent="Copa do Mundo " + year;
  document.querySelectorAll('.album-switch button').forEach(b=>b.classList.toggle('active',b.dataset.year===year));
  go('cupDetail'); renderGroups(); renderStickers();
}
function flagIcon(t){return FLAGS[t]||'🏳️'}
function renderGroups(){
  let out='';
  (GROUPS[currentYear]||[]).forEach(g=>{
    const teams=g.slice(1);
    const opened=teams.includes(currentTeam);
    out+=`<div class="group-panel ${opened?'open':''}"><button class="group-toggle" onclick="toggleGroup('${g[0]}')"><b class="group-title">GRUPO ${g[0]}</b><span class="group-flags">${teams.map(t=>`<span class="team-flag">${flagIcon(t)}</span>`).join('')}</span></button><div class="group-teams">${teams.map(t=>`<button class="team-link ${currentTeam===t?'active':''}" onclick="openTeam('${g[0]}','${t}')"><span class="team-flag">${flagIcon(t)}</span><b>${t}</b></button>`).join('')}</div></div>`;
  });
  const head=`<div class="album-side-head"><b>ÁLBUM ${currentYear}</b><span>SELEÇÕES</span></div>`;
  document.getElementById('groups').innerHTML=head+out;
}
function toggleGroup(g){
  document.querySelectorAll('.group-panel').forEach(p=>{
    if(p.innerText.includes('GRUPO '+g)) p.classList.toggle('open');
  });
}
function openTeam(g,t){
  currentGroup=g; currentTeam=t; stickerQuery='';
  renderGroups(); renderStickers();
  document.getElementById('teamWorkspace').scrollIntoView({behavior:'smooth',block:'nearest'});
}
function teamIndex(y,t){return (GROUPS[y]||[]).flatMap(g=>g.slice(1)).indexOf(t)}
function albumRange(y,t){
  const idx=teamIndex(y,t);
  if(idx===-1) return [1,20];
  if(y==='2014') return [32+idx*19, 32+idx*19+18];
  if(y==='2018') return [32+idx*20, 32+idx*20+19];
  return [1,20];
}
function stickerCode(n){
  if(currentYear==='2014'||currentYear==='2018') return String(n);
  const p=currentTeam.substring(0,3).toUpperCase();
  return p+' '+n;
}
function renderStickers(){
  const box=document.getElementById('teamWorkspace');
  const [first,last]=albumRange(currentYear,currentTeam);
  let cards='';
  const pal=TEAM_PALETTES[currentTeam]||['#083b8f','#f1bd37','#ffffff'];
  
  for(let n=first;n<=last;n++){
    const code=stickerCode(n);
    if(stickerQuery && !code.toLowerCase().includes(stickerQuery.toLowerCase())) continue;
    const price= (n===first)? 8.00 : (n%5===0 ? 4.50 : 2.50);
    const qty= (n%7===0)? 0 : ((n*3)%6)+1;
    const unav= qty<=0;
    
    cards+=`<article class="product-card" onclick="showItem('${code}','',${qty},${price},${n})">
      <div class="product-art">
        <div class="flag-sticker" style="--f1:${pal[0]};--f2:${pal[1]};--f3:${pal[2]}">
          <span class="flag-motif">⚽</span>
        </div>
      </div>
      <div class="product-code">${code}</div>
      <div class="product-meta">
        <span class="${unav?'sold-out':''}">${unav?'0':qty} un.</span>
        <span>${unav?'R$ —':money(price)}</span>
      </div>
    </article>`;
  }
  
  box.innerHTML=`<div class="team-toolbar"><div class="team-head"><span class="team-flag">${flagIcon(currentTeam)}</span><div><h2>${esc(currentTeam)}</h2><span class="muted">Grupo ${currentGroup} • ${last-first+1} figurinhas</span></div></div><label class="team-search"><input placeholder="Buscar número..." value="${esc(stickerQuery)}" oninput="stickerQuery=this.value;renderStickers()"><button class="clear-search" onclick="stickerQuery='';renderStickers()">×</button></label></div><div class="product-grid">${cards}</div>`;
}
function showItem(code,img,qty,price,n){
  document.getElementById('modalCode').textContent=code;
  document.getElementById('modalPrice').textContent=qty>0?`${money(price)} • ${qty} un. disponível`:'Produto indisponível';
  const pal=TEAM_PALETTES[currentTeam]||['#083b8f','#f1bd37','#ffffff'];
  document.getElementById('modalFallback').innerHTML=`<div class="flag-sticker" style="--f1:${pal[0]};--f2:${pal[1]};--f3:${pal[2]};width:100%;height:100%;"><span class="flag-motif" style="font-size:60px">⚽</span></div>`;
  const add=document.getElementById('modalAdd');
  add.disabled=qty<=0;
  add.onclick=()=>{if(qty<=0)return;addToCart(`Copa ${currentYear} • ${currentTeam} • ${code}`,price,qty,true);closeItem()};
  document.getElementById('itemModal').classList.add('open');
}
function closeItem(){document.getElementById('itemModal').classList.remove('open')}
function addToCart(name,price,stock,notify){
  let x=cart.find(i=>i.name===name);
  if(x){
    if(x.qty>=stock){if(notify)alert('Quantidade máxima atingida.');return}
    x.qty++;
  }else{
    cart.push({name,price,stock,qty:1});
  }
  saveCart();
  if(notify) alert('Adicionado ao carrinho!');
}
function saveCart(){localStorage.setItem('cf_cart',JSON.stringify(cart));updateCounts()}
function updateCounts(){
  let c=cart.reduce((a,i)=>a+i.qty,0);
  document.getElementById('cartCount').textContent=c;
  document.getElementById('bottomCount').textContent=`${c} ${c===1?'ITEM':'ITENS'}`;
}
function showCart(){go('cart')}
function renderCart(){
  let box=document.getElementById('cartItems');
  if(!cart.length){box.innerHTML='<div class="card">Seu carrinho está vazio.</div>';document.getElementById('cartTotal').textContent=money(0);return}
  box.innerHTML=cart.map((i,k)=>`<div class="cartline"><div><b>${i.name}</b><br><span class="muted">${money(i.price)} cada</span></div><div><button class="back" onclick="qty(${k},-1)">−</button> ${i.qty} <button class="back" onclick="qty(${k},1)">+</button><br><b>${money(i.price*i.qty)}</b></div></div>`).join('');
  document.getElementById('cartTotal').textContent=money(total());
}
function qty(k,d){
  let i=cart[k];
  if(d>0&&i.qty>=i.stock){alert('Limite de estoque atingido.');return}
  i.qty+=d;
  if(i.qty<=0) cart.splice(k,1);
  saveCart(); renderCart();
}
function total(){return cart.reduce((a,i)=>a+i.price*i.qty,0)}
function deliveryChanged(){
  let v=document.getElementById('delivery').value;
  document.getElementById('pickupBox').classList.toggle('hidden',v!=='pickup');
  document.getElementById('addressBox').classList.toggle('hidden',v!=='shipping');
}
function reviewOrder(){
  if(!cart.length){alert('Carrinho vazio.');return}
  let name=document.getElementById('name').value.trim(),phone=document.getElementById('phone').value.trim(),d=document.getElementById('delivery').value;
  if(!name||!phone||!d){alert('Preencha os campos obrigatórios.');return}
  let lines=cart.map(i=>`${i.qty}x ${i.name} = ${money(i.qty*i.price)}`).join('<br>');
  document.getElementById('reviewText').innerHTML=`<b>${name}</b><br>${lines}<hr>Total: <b>${money(total())}</b>`;
  document.getElementById('pixArea').classList.toggle('hidden',d!=='pickup');
  document.getElementById('pixTotal').textContent=money(total());
  document.getElementById('pixCode').value=PIX_CODE;
  go('review');
}
function copyPix(){
  const el=document.getElementById('pixCode');
  navigator.clipboard.writeText(el.value).then(()=>alert('Pix copiado com sucesso!'));
}
function sendWhatsApp(){
  let name=document.getElementById('name').value, phone=document.getElementById('phone').value, d=document.getElementById('delivery').value;
  let lines=cart.map(i=>`${i.qty}x ${i.name} - ${money(i.qty*i.price)}`).join('\n');
  let msg=`PEDIDO NOVO\nCliente: ${name}\nWhatsApp: ${phone}\n\nITENS:\n${lines}\n\nTotal: ${money(total())}\nRecebimento: ${d}`;
  window.open('https://wa.me/'+WHATSAPP+'?text='+encodeURIComponent(msg),'_blank');
}
function quickSearch(){
  let q=document.getElementById('globalSearch').value.trim();
  if(!q) return;
  openCup('2022');
}
function showShopArea(area){
  const box=document.getElementById('shopShelf');
  box.innerHTML=`<div class="shop-shelf-icon">📦</div><div><h2>Categoria: ${area.toUpperCase()}</h2><p>Carregando itens disponíveis...</p></div>`;
}

updateCounts();
go('home');
